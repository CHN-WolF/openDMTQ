# Game content, APKs, keystore and the live database. Gigabytes, and none of it is ours.
/data/

# Scratch area: downloaded tutorial videos and their frames.
/_work/

# Local settings (LAN address).
.env

__pycache__/
*.pyc

# The runtime for newer phones as a release job or a Windows build leaves it beside its code: a release's, not the source's.
/tools/opendmtq_tools/opendmtq-arm32-runtime.zip
# The player for Windows, likewise (arm32/bundle_windows.sh), and the PC client's installer with its version
# (client/packaging/windows/build.sh).
/tools/opendmtq_tools/opendmtq-player-windows.zip
/tools/opendmtq_tools/OpenDMTQ-Setup.exe
/tools/opendmtq_tools/OpenDMTQ-Setup.exe.version
# And the PC client's update files beside it (its feed, its packages, the release's signed checksums), which a server
# hands out to its launchers (tools/opendmtq_tools/client_updates.py).
/tools/opendmtq_tools/pc-client-updates/

# A test build's own public keys beside the signing module (client/packaging/windows/build.sh writes the launcher's from
# OPENDMTQ_TEST_UPDATE_KEY, a test writes the tools'): never a release's, never the repository's.
update-test-keys.txt

# A host install's own programs and run files (host/install.sh).
/.host/
